+/* Match oracle-v5 gathered decode: 32 split-K groups, 32 keys per SIMD
+ * group. The SIMD-group count changes the floating-point reduction order. */
+static uint32_t flash_vec_decode_nsg(uint32_t n_keys) {
+    uint32_t nsg = 1u;
+    while (2u * 32u * nsg * 32u < n_keys && nsg < 4u) nsg *= 2u;
+    return nsg;
+}
+
+static id<MTLComputePipelineState> flash_vec_decode_pipeline(
+    RustStarMetalContext *context, uint32_t nsg, char *error, size_t error_bytes)
+{
+    if (nsg == 1u) return context.flashVecPipeline;
+    if (nsg == 2u && context.flashVecNsg2Pipeline) return context.flashVecNsg2Pipeline;
+    if (nsg == 4u && context.flashVecNsg4Pipeline) return context.flashVecNsg4Pipeline;
+    if (nsg != 2u && nsg != 4u) {
+        fail_with_message(error, error_bytes, @"invalid decode FlashAttention SIMD-group count");
+        return nil;
+    }
+    bool enabled = true, disabled = false;
+    int32_t head_dim = 512, groups = (int32_t)nsg, nwg = 32;
+    MTLFunctionConstantValues *constants = [MTLFunctionConstantValues new];
+    [constants setConstantValue:&enabled type:MTLDataTypeBool atIndex:400];
+    [constants setConstantValue:&enabled type:MTLDataTypeBool atIndex:401];
+    [constants setConstantValue:&disabled type:MTLDataTypeBool atIndex:402];
+    [constants setConstantValue:&disabled type:MTLDataTypeBool atIndex:403];
+    [constants setConstantValue:&enabled type:MTLDataTypeBool atIndex:404];
+    [constants setConstantValue:&disabled type:MTLDataTypeBool atIndex:405];
+    [constants setConstantValue:&head_dim type:MTLDataTypeInt atIndex:420];
+    [constants setConstantValue:&head_dim type:MTLDataTypeInt atIndex:421];
+    [constants setConstantValue:&groups type:MTLDataTypeInt atIndex:422];
+    [constants setConstantValue:&nwg type:MTLDataTypeInt atIndex:423];
+    NSError *compile_error = nil;
+    id<MTLFunction> function = [context.attentionIngressLibrary
+        newFunctionWithName:@"kernel_flash_attn_ext_vec_f16_dk512_dv512"
+        constantValues:constants error:&compile_error];
+    id<MTLComputePipelineState> pipeline = function
+        ? [context.device newComputePipelineStateWithFunction:function error:&compile_error] : nil;
+    if (!pipeline) {
+        fail_with_message(error, error_bytes, compile_error.localizedDescription);
+        return nil;
+    }
+    if (nsg == 2u) context.flashVecNsg2Pipeline = pipeline;
+    else context.flashVecNsg4Pipeline = pipeline;
+    return pipeline;
+}
